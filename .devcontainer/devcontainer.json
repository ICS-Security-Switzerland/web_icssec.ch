{
  "name": "Jekyll DevContainer ICS Security",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/ruby:1": {
      "version": "3.1"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts",
      "nodeGypDependencies": false
    }
  },
  "containerEnv": {
    "BUNDLE_PATH": "/workspaces/web_icssec.ch/vendor/bundle",
    "BUNDLE_JOBS": "4",
    "BUNDLE_RETRY": "3"
  },
  "forwardPorts": [4000, 35729],
  "portsAttributes": {
    "4000": { "label": "Jekyll", "onAutoForward": "openBrowser", "visibility": "private" },
    "35729": { "label": "LiveReload", "visibility": "private" }
  }
}